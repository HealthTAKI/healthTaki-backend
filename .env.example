# Postgres connection string
DATABASE_URL=postgres://healthtaki:healthtaki@localhost:5432/healthtaki

# Long random secret used to sign provider JWTs. Generate with:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-value

# How long an issued session token stays valid (seconds). Default: 24h.
JWT_EXPIRES_IN_SECONDS=86400

# How long a wallet-signing challenge stays valid before it must be re-requested (seconds).
AUTH_CHALLENGE_TTL_SECONDS=300

# HTTP port the API listens on.
PORT=8080

# Origin allowed to call this API (the Next.js frontend).
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Informational only (not used for signature verification): which Stellar
# network the paired frontend is pointed at, TESTNET or PUBLIC.
STELLAR_NETWORK=TESTNET
